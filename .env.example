# Docker Compose environment variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intel_hub

# Service URLs used by local tooling
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intel_hub
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Daily briefing defaults and delivery
BRIEFING_MIN_RELEVANCE=6.0
BRIEFING_PUSH_ENABLED=true
FEISHU_WEBHOOK_URL=
FEISHU_PUSH_TOP_N=5
BRIEFING_PUBLIC_BASE_URL=http://localhost:3000
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RSSHub (optional: docker compose --profile rsshub up -d)
RSSHUB_BASE_URL=http://localhost:1200

# Apify X scraper (optional source_type=apify)
APIFY_TOKEN=
APIFY_TWITTER_ACTOR=apidojo~tweet-scraper

# AI HOT REST API
AIHOT_API_BASE=https://aihot.virxact.com

# X session cookies (Bird) or paid API
X_BEARER_TOKEN=
X_AUTH_TOKEN=
X_CT0=
HTTP_SSL_VERIFY=true
