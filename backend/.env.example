# Application
APP_NAME=intel-hub
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intel_hub

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security
SECRET_KEY=change-this-intel-hub-dev-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Intel Hub
INGEST_DEFAULT_INTERVAL_MINUTES=30
INTEL_PROMPT_TEMPLATE=intelligence/analyze

# X (Twitter) — official API and/or Bird session cookies (last30days-style)
X_BEARER_TOKEN=
X_AUTH_TOKEN=
X_CT0=
X_RSS_BRIDGE_BASE=https://rss.xcancel.com

# Set false only if HTTPS proxy (e.g. Clash) breaks certificate verification
HTTP_SSL_VERIFY=true

# Briefing push (Feishu / n8n / Telegram)
BRIEFING_PUSH_ENABLED=true
FEISHU_WEBHOOK_URL=
FEISHU_PUSH_TOP_N=5
BRIEFING_PUBLIC_BASE_URL=http://localhost:3000

# Daily archive (Beijing calendar day)
ARCHIVE_ENABLED=true
ARCHIVE_TIMEZONE=Asia/Shanghai
ARCHIVE_WINDOW_HOURS=24
ARCHIVE_BRIEFING_LIMIT=20
ARCHIVE_MIN_RELEVANCE=6.0
